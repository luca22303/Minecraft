	"name": "Winter Wonderland",
	"description": "A cozy, immersive winter ambience mod - turn your world into a snowy wonderland.",
	"authors": [
		"luca22303"
	],
	"contact": {
		"sources": "https://github.com/luca22303/Minecraft"
	},
	"license": "CC0-1.0",
	"icon": "assets/winterwonderland/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.luca22303.winterwonderland.WinterWonderland"
		],
		"client": [
